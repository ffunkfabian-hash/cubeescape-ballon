#!/usr/bin/env python3
"""Schnelle Prüfung (quick, ohne Blender): Syntax, Datenmodule, Specs, Matrix, erzeugte Doku. Exit 1 bei Fehler."""
import glob
import importlib
import json
import os
import subprocess
import sys

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
err = []


def fail(msg):
    err.append(msg)


for f in glob.glob(os.path.join(ROOT, '**', '*.py'), recursive=True) + [os.path.join(ROOT, 'check')]:
    try:
        compile(open(f, encoding='utf-8').read(), f, 'exec')
    except SyntaxError as e:
        fail(f'Syntax: {f}: {e}')

from basic import common, matrix  # noqa: E402

types = set()
for f in sorted(glob.glob(os.path.join(ROOT, 'basic', 'weapons', 'w*.py'))):
    W = importlib.import_module('basic.weapons.' + os.path.basename(f)[:-3])
    wid = W.META['id']
    ids = [p['id'] for p in W.PARTS]
    if len(ids) != len(set(ids)):
        fail(f'{wid}: doppelte Bauteil-IDs')
    if W.META['type'] in types:
        fail(f'{wid}: Typ doppelt')
    types.add(W.META['type'])
    asm = {a['id'] for a in W.ASSEMBLIES}
    for p in W.PARTS:
        for k in ('de', 'en', 'func', 'attach', 'mat'):
            if not p.get(k):
                fail(f'{wid}/{p["id"]}: Feld {k} leer')
        if p['asm'] not in asm:
            fail(f'{wid}/{p["id"]}: Baugruppe {p["asm"]} fehlt')
        if p.get('parent_part') and p['parent_part'] not in ids:
            fail(f'{wid}/{p["id"]}: Elternteil fehlt')
        if p.get('iface') and p['iface'] not in common.INTERFACES:
            fail(f'{wid}/{p["id"]}: Schnittstelle {p["iface"]} unbekannt')
    for k in ('Socket_Hand', 'Socket_Muzzle'):
        if k not in W.ANCHORS:
            fail(f'{wid}: Anker {k} fehlt')
    for a, A in W.ACTIONS.items():
        for pid in A['keys']:
            p = next((x for x in W.PARTS if x['id'] == pid), None)
            if not p or 'move' not in p:
                fail(f'{wid}/{a}: Teil {pid} ohne Bewegung')
    sp = os.path.join(ROOT, 'data', 'specs', f'{wid}.spec.json')
    if not os.path.exists(sp):
        fail(f'{wid}: Spec fehlt (tools/sync_specs.py)')
        continue
    S = json.load(open(sp, encoding='utf-8'))
    if S.get('format') != 'cubeescape-ballon/basic-spec' or S.get('format_version') != 1:
        fail(f'{wid}: Spec-Format')
    if [p['id'] for p in S['parts']] != ids:
        fail(f'{wid}: Spec passt nicht zum Entwurf (neu bauen)')
    if S['counts']['triangles'] > 10000:
        fail(f'{wid}: {S["counts"]["triangles"]} Dreiecke > 10 000 (Toolgen-Weltbudget)')
    for r, s, d in matrix.status(W.META, list(W.ACTIONS), ''):
        if s not in ('dargestellt', 'nicht anwendbar', 'offen') or not d:
            fail(f'{wid}/{r["id"]}: Matrixfeld leer')
rv = json.load(open(os.path.join(ROOT, 'data', 'review.json'), encoding='utf-8'))
for f in sorted(glob.glob(os.path.join(ROOT, 'basic', 'weapons', 'w*.py'))):
    W = importlib.import_module('basic.weapons.' + os.path.basename(f)[:-3])
    miss = set(W.ACTIONS) - set(rv.get(W.META['id'], {}).get('actions', {}))
    if miss:
        fail(f"{W.META['id']}: Sichtung fehlt in data/review.json für {sorted(miss)}")
# Stil-v2.1-Familie (basic/pilot/w*_v21.py): gleiche Strukturprüfung, Sichtung je Ansicht und Aktion in data/review.json
for f in sorted(glob.glob(os.path.join(ROOT, 'basic', 'pilot', 'w*_v21.py'))):
    W = importlib.import_module('basic.pilot.' + os.path.basename(f)[:-3])
    wid = f"{W.META['id']}-{W.META['variant']}"
    ids = [p['id'] for p in W.PARTS]
    if len(ids) != len(set(ids)):
        fail(f'{wid}: doppelte Bauteil-IDs')
    asm = {a['id'] for a in W.ASSEMBLIES}
    for p in W.PARTS:
        for k in ('de', 'en', 'func', 'attach', 'mat'):
            if not p.get(k):
                fail(f'{wid}/{p["id"]}: Feld {k} leer')
        if p['asm'] not in asm:
            fail(f'{wid}/{p["id"]}: Baugruppe {p["asm"]} fehlt')
        if p.get('parent_part') and p['parent_part'] not in ids:
            fail(f'{wid}/{p["id"]}: Elternteil fehlt')
        if p.get('iface') and p['iface'] not in common.INTERFACES:
            fail(f'{wid}/{p["id"]}: Schnittstelle {p["iface"]} unbekannt')
    for k in ('Socket_Hand', 'Socket_Muzzle', 'Socket_Eye'):
        if k not in W.ANCHORS:
            fail(f'{wid}: Anker {k} fehlt')
    for a, A in W.ACTIONS.items():
        for pid in A['keys']:
            p = next((x for x in W.PARTS if x['id'] == pid), None)
            if not p or 'move' not in p:
                fail(f'{wid}/{a}: Teil {pid} ohne Bewegung')
    sp = os.path.join(ROOT, 'data', 'specs', f'{wid}.spec.json')     # Quelle der Familienmaße (docs/familienmasse.md)
    if not os.path.exists(sp):
        fail(f'{wid}: Spec fehlt in data/specs (Vollrendering, dann tools/sync_specs.py)')
    else:
        S = json.load(open(sp, encoding='utf-8'))
        if [p['id'] for p in S['parts']] != ids:
            fail(f'{wid}: Spec passt nicht zum Entwurf (neu bauen, tools/sync_specs.py)')
        for k, A in W.ANCHORS.items():
            q = S['anchors'].get(k, {}).get('position_m')
            at = list(A['at']) + [0] * (3 - len(A['at']))
            if not q or max(abs(-q[1] * 1000 - at[0]), abs(q[2] * 1000 - at[1]), abs(q[0] * 1000 - at[2])) > 0.6:
                fail(f'{wid}: Anker {k} im Spec weicht vom Entwurf ab (neu bauen, tools/sync_specs.py)')
    from basic.reticles import SIGHT   # Visier-Standard: Höhe 66 ± 4 mm, Augenabstand je Visiertyp
    e = W.ANCHORS.get('Socket_Eye', {})
    if not e.get('std') or e.get('sight_type') not in SIGHT['types']:
        fail(f'{wid}: Socket_Eye nicht nach Visier-Standard (std, sight_type)')
    else:
        h = e['at'][1] - W.BORE
        if abs(h - SIGHT['height_mm']) > SIGHT['height_tol_mm']:
            fail(f'{wid}: Visierhöhe {h:.1f} mm außerhalb {SIGHT["height_mm"]:.0f} ± {SIGHT["height_tol_mm"]:.0f} mm')
        T = SIGHT['types'][e['sight_type']]
        rel = W.ANCHORS[T['ref']]['at'][0] - e['at'][0]
        if abs(rel - T['eye_relief_mm']) > 0.5:
            fail(f'{wid}: Augenabstand {rel:.1f} mm statt {T["eye_relief_mm"]:.0f} mm ({e["sight_type"]})')
        # Visier-Standard 3: Öffnung im Zielen (Anteil der Bildbreite beim Bezugsbildwinkel) und Visiertyp passend zur Klasse
        import math as _m
        from basic.reticles import SIGHT_KIND
        byid = {p['id']: p for p in W.PARTS}
        width = byid['sight_glass']['ww'] if e['sight_type'] == 'reflex' else 2 * byid['scope_rim']['r']
        share = width / (2 * T['eye_relief_mm'] * _m.tan(_m.radians(SIGHT['fov_ref_deg'] / 2)))
        lo, hi = T['target_share']
        if not lo <= share <= hi:
            fail(f'{wid}: Öffnung im Zielen {share * 100:.1f} % außerhalb {lo * 100:.0f}–{hi * 100:.0f} %')
        want = {'holo': 'reflex', 'ring_scope': 'scope'}.get(SIGHT_KIND.get(W.META['type']))
        if want and want != e['sight_type']:
            fail(f'{wid}: Visiertyp {e["sight_type"]} passt nicht zur Klasse (Visier-Standard 3: {SIGHT_KIND[W.META["type"]]})')
    E = getattr(W, 'EJECT', None)   # Hülsenauswurf (0.16, 5.4 A): Datenfeld je Waffe, Startlage und Hülsenform müssen bestehen
    if E is not None:
        from basic.arms import ego as EG
        if len(E.get('at', ())) != 3 or E.get('case') not in EG.EJECT['cases'] or len(E.get('dir', ())) != 3:
            fail(f'{wid}: EJECT unvollständig (Startlage f/u/x, Hülsenform aus ego.EJECT.cases, Richtung f/u/x)')
    if 'Formsprache-Checkliste' not in (W.__doc__ or '') and W.META['id'] != 'BASIC-01':
        fail(f'{wid}: Checkliste (stilhandbuch §3) fehlt im Docstring')
    R = rv.get(wid, {})
    if R.get('static', {}).get('status') != 'geprüft':
        fail(f'{wid}: Sichtung der Ansichten fehlt in data/review.json')
    miss = set(W.ACTIONS) - set(R.get('actions', {}))
    if miss:
        fail(f'{wid}: Sichtung fehlt in data/review.json für {sorted(miss)}')
if len(types) != 17:
    fail(f'{len(types)} Grundtypen statt 17')
BL = os.environ.get('BLENDER', '/Applications/Blender.app/Contents/MacOS/Blender')
if os.path.exists(BL):   # Drehsinn-Test (Blender ohne Szene, ~2 s)
    r = subprocess.run([BL, '-b', '--factory-startup', '-P', os.path.join(ROOT, 'tools', 'test_motion.py')], capture_output=True, text=True)
    if r.returncode or 'Bewegungen geprüft' not in r.stdout:
        fail('Drehsinn: ' + ' | '.join(ln for ln in r.stdout.splitlines() if 'test_motion' in ln))
elif os.environ.get('GITHUB_ACTIONS') == 'true':   # PR-Check auf Linux: Blender-Stufen bleiben auf dem Mac (check.yml)
    print('Hinweis: Blender fehlt im PR-Check – Drehsinn-Test nur auf dem Mac')
else:
    fail('Blender fehlt: Drehsinn-Test nicht ausgeführt (BLENDER setzen)')
r = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'make_ego.py'), '--check'], capture_output=True, text=True)
if r.returncode:
    fail('Ego-Daten: ' + r.stdout.strip())
r = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'export_reticles.py'), '--check'], capture_output=True, text=True)
if r.returncode:
    fail('Absehen-Export veraltet: python3 tools/export_reticles.py (' + r.stdout.strip() + ')')
from basic import reticles as RT   # Entscheidungsliste 1.2 A, 4.1 A, 4.2 A (Nutzer 25.10.2026): Weltzoom und Hüft-Fadenkreuz nach Glidepath
for k, z in {'scout_rifle': 2.0, 'hand_cannon': 1.15, 'submachine_gun': 1.45, 'auto_rifle': 1.9, 'pulse_rifle': 2.0, 'machine_gun': 1.9,
             'sidearm': 1.25, 'grenade_launcher': 1.4, 'linear_fusion_rifle': 3.8}.items():
    if abs(RT.class_world_zoom(k) - z) > 1e-6:
        fail(f'Weltzoom {k} {RT.class_world_zoom(k)} statt {z} (Entscheidungsliste 1.2 A)')
for k, (kind, sh) in {'auto_rifle': ('ring_dot', 0.032), 'pulse_rifle': ('ring_dot', 0.032), 'machine_gun': ('ring_dot', 0.032),
                      'hand_cannon': ('brackets', 0.06), 'sniper_rifle': ('caret', 0.01), 'submachine_gun': ('circle_cross', 0.061)}.items():
    h = RT.hip(k)
    if (h['kind'], h['share_h']) != (kind, sh):
        fail(f"Hüft-Fadenkreuz {k}: {h['kind']} {h['share_h']} statt {kind} {sh} (Entscheidungsliste 4.2 A)")
if (RT.HIP['color'], RT.HIP['weight']) != ('white', 'fine') or {k: v['kind'] for k, v in RT.HIP['sprint'].items()} != {'auto_rifle': 'caret'}:
    fail('Hüft-Fadenkreuz: weiß, fein, im Sprint nur die Automatik mit „^“ (Entscheidungsliste 4.1 A)')
from basic.arms import ego as EG   # Entscheidungsliste 5.3 A: Mündungsfeuer 1 Bild bei 30/s, im Zielen ≤ 20 % der Holo-Öffnung
import tools.export_unity as _XU
_cov = EG.flash_cover_ads(importlib.import_module(f'basic.{_XU.WEAPON}'))
if _cov > 0.20 or abs(EG.FLASH['dur_s'] * EG.FPS - 1) > 1e-9:
    fail(f'Mündungsfeuer: Öffnung im Zielen zu {_cov * 100:.1f} % bedeckt (≤ 20 %) oder nicht genau 1 Bild bei 30/s')
r = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'export_unity.py'), '--check'], capture_output=True, text=True)
if r.returncode:
    fail('Unity-Daten: ' + r.stdout.strip())
r = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'scene_build.py'), '--check'], capture_output=True, text=True)
if r.returncode:
    fail('Szenen: ' + r.stdout.strip())
r = subprocess.run([sys.executable, os.path.join(ROOT, 'tools', 'make_docs.py'), '--check'], capture_output=True, text=True)
if r.returncode:
    fail('Erzeugte Doku veraltet: python3 tools/make_docs.py (' + r.stdout.strip() + ')')
print('\n'.join(err) if err else 'check: alles in Ordnung (17 Grundtypen, Specs, Matrix, Doku)')
sys.exit(1 if err else 0)
