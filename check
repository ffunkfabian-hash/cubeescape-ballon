def _key_value(keys, fr):
    """Wert einer Bewegung im Bild fr wie tools/blender_build.value_at (dort mit bpy geladen): erster passender Abschnitt, Smoothstep."""
    if fr <= keys[0][0]:
        return keys[0][1]
    for (f0, v0), (f1, v1) in zip(keys, keys[1:]):
        if f0 <= fr <= f1:
            x = max(0.0, min(1.0, (fr - f0) / (f1 - f0))) if f1 > f0 else 1.0
            return v0 + (v1 - v0) * x * x * (3 - 2 * x)
    return keys[-1][1]

